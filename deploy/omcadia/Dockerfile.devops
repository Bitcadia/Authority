FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS node
FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git python3 libicu74 libssl3t64 libkrb5-3 zlib1g liblttng-ust1t64 unzip \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 1001 signer && useradd -u 1001 -g 1001 -m signer \
    && mkdir /agent /state && chown 1001:1001 /agent /state
COPY --from=node /usr/local/bin/node /usr/local/bin/node
ARG AGENT_VERSION=5.278.0
RUN curl -fsSL "https://download.agent.dev.azure.com/agent/${AGENT_VERSION}/vsts-agent-linux-x64-${AGENT_VERSION}.tar.gz" | tar -xz -C /agent \
    && chown -R 1001:1001 /agent
COPY tools/sign-publication.mjs tools/validate-publication.mjs tools/devops-sign.mjs /opt/authority/tools/
COPY tools/devops-hook.py /opt/authority/tools/devops_hook.py
COPY sources/publication.json /opt/authority/sources/publication.json
COPY deploy/omcadia/init-devops.sh /usr/local/bin/init-devops
RUN chmod 755 /usr/local/bin/init-devops
USER signer
WORKDIR /agent
ENTRYPOINT ["/usr/local/bin/init-devops"]
