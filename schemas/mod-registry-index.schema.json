{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Bitcadia/Authority/main/schemas/mod-registry-index.schema.json",
  "title": "bitcadia64 per-base-game registry index",
  "description": "Content-addressed list of per-base-game mod lists and curated category picks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "generatedAt", "notice", "categoryDefinitions", "games"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/Bitcadia/Authority/main/schemas/mod-registry-index.schema.json" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "notice": { "type": "string", "minLength": 1 },
    "categoryDefinitions": {
      "type": "array", "maxItems": 64,
      "description": "Authority-defined categories extending the four canonical categories.",
      "items": { "$ref": "#/$defs/categoryDefinition" }
    },
    "games": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": { "$ref": "#/$defs/game" }
    },
    "continuation": {
      "$ref": "#/$defs/indexReference",
      "description": "Omit this property on the final page; explicit null is invalid."
    }
  },
  "$defs": {
    "hex8": { "type": "string", "pattern": "^[0-9A-Fa-f]{8}$" },
    "hex64": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
    "httpsUrl": { "type": "string", "pattern": "^https://(?![0-9.]+/)(?![^/]*\\.[Ll][Oo][Cc][Aa][Ll]/)(?=[^/]*\\.)(?:(?!0[xX])[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?\\.)+(?!0[xX])[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?/[^#\\\\\\r\\n\\t]+$" },
    "categoryId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
    "base": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "variant", "normalizedCrc32", "normalizedSha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "variant": { "type": "string", "minLength": 1 },
        "gameCode": { "type": "string", "minLength": 1, "maxLength": 8 },
        "normalizedCrc32": { "$ref": "#/$defs/hex8" },
        "normalizedSha256": { "$ref": "#/$defs/hex64" }
      }
    },
    "listReference": {
      "type": "object", "additionalProperties": false,
      "required": ["documentType", "url", "sha256", "size", "entryCount", "allowRedirects"],
      "properties": {
        "documentType": { "const": "mod-registry" },
        "url": { "$ref": "#/$defs/httpsUrl" },
        "sha256": { "$ref": "#/$defs/hex64" },
        "size": { "type": "integer", "minimum": 1, "maximum": 8388608 },
        "entryCount": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "allowRedirects": { "const": false }
      }
    },
    "indexReference": {
      "type": "object", "additionalProperties": false,
      "required": ["documentType", "url", "sha256", "size", "gameCount", "allowRedirects"],
      "properties": {
        "documentType": { "const": "mod-registry-index" },
        "url": { "$ref": "#/$defs/httpsUrl" },
        "sha256": { "$ref": "#/$defs/hex64" },
        "size": { "type": "integer", "minimum": 1, "maximum": 8388608 },
        "gameCount": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "allowRedirects": { "const": false }
      }
    },
    "categoryDefinition": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/categoryId" },
        "label": { "type": "string", "minLength": 1, "maxLength": 64 },
        "description": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "pick": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "entryId", "name", "version", "outputSha256"],
      "properties": {
        "category": { "$ref": "#/$defs/categoryId" },
        "entryId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "maxLength": 96 },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$" },
        "outputSha256": { "$ref": "#/$defs/hex64" }
      }
    },
    "game": {
      "type": "object", "additionalProperties": false,
      "required": ["base", "list", "picks"],
      "properties": {
        "base": { "$ref": "#/$defs/base" },
        "list": { "$ref": "#/$defs/listReference" },
        "picks": {
          "type": "array", "maxItems": 1000,
          "description": "At most one entry for each canonical category. Authority-defined categories may feature multiple distinct entries.",
          "items": { "$ref": "#/$defs/pick" }
        }
      }
    }
  }
}
