{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Bitcadia/Authority/main/schemas/authority-payload-v1.schema.json",
  "title": "bitcadia64 authority gossip payload",
  "description": "Signed discovery statement binding an authority to one exact mod registry and a bounded list of peer observations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "authorityId", "displayName", "sequence", "issuedAt",
    "expiresAt", "previousManifestSha256", "registry", "peers"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "authorityId": { "$ref": "#/$defs/authorityId" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 96 },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "previousManifestSha256": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
    },
    "registry": { "$ref": "#/$defs/registry" },
    "peers": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/peer" }
    }
  },
  "$defs": {
    "authorityId": {
      "type": "string",
      "pattern": "^ed25519:[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "directHttpsUrl": {
      "type": "string",
      "pattern": "^https://(?![0-9.]+/)(?![^/]*\\.[Ll][Oo][Cc][Aa][Ll]/)(?=[^/]*\\.)(?:(?!0[xX])[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?\\.)+(?!0[xX])[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?/[^#\\\\\\r\\n\\t]+$"
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "size", "entryCount"],
      "properties": {
        "url": { "$ref": "#/$defs/directHttpsUrl" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1, "maximum": 8388608 },
        "entryCount": { "type": "integer", "minimum": 1, "maximum": 100000 }
      }
    },
    "peer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayName", "registry"
      ],
      "properties": {
        "displayName": { "type": "string", "minLength": 1, "maxLength": 96 },
        "registry": { "$ref": "#/$defs/registry" },
        "manifestUrl": { "$ref": "#/$defs/directHttpsUrl" },
        "manifestSha256": { "$ref": "#/$defs/sha256" }
      },
      "dependentRequired": {
        "manifestUrl": ["manifestSha256"],
        "manifestSha256": ["manifestUrl"]
      }
    }
  }
}
